From 8d9e1ff35dcfd7a0e72f754094e8249ec4f96573 Mon Sep 17 00:00:00 2001
From: Arnaldo Lima <arnaldolimaof@gmail.com>
Date: Fri, 16 Oct 2026 06:50:44 -0300
Subject: [PATCH] GCM: give a FIFO park time to be patched; HOTREAD16 names the
 reader

A JUMP-to-self park with put elsewhere was abandoned at once (resync to
put). God of War: Ascension drives its RSX with parks alone: put sits at
the end of an 8 MB ring and the vblank handler rewrites each park into a
JUMP to the next frame. Skipping to put dropped whole frames. Wait
GCM_PARK_WAIT_MS (default 2000) for the patch before resyncing.

[HOTREAD16] now prints the value, thread, guest function and lr, like
the 8- and 32-bit detectors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/video/cellGcmSys.c    | 24 ++++++++++++++++++++++--
 runtime/ppu/ppu_loader.cpp |  2 +-
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index f3e25ef..de67c02 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1746,8 +1746,28 @@ static void gcm_rsx_process_fifo_unlocked(void)
                    * park standing -- it only patches a park when it reuses that
                    * block. Waiting for a patch that will not come freezes the
                    * FIFO for the rest of the run, so follow the write head. */
-                  if (put != s_fifo_getoff) { gcm_fifo_dump_around(s_fifo_getoff);
-                                              gcm_fifo_resync_why("jump-park", &s_fifo_getoff, put); }
+                  /* ...but not at once. A title may park the RSX while the
+                   * next segment is still being built and patch the park
+                   * afterwards: God of War: Ascension moves `put` to the end
+                   * of a frame its SPU jobs are still filling, then rewrites
+                   * the park into a JUMP to it. Following the write head at
+                   * once skipped the whole frame -- including the user
+                   * command that releases the frame slot the render thread
+                   * waits on -- so nothing was ever drawn. Give the patch
+                   * GCM_PARK_WAIT_MS (default 2000) before giving up. */
+                  if (put != s_fifo_getoff) {
+                      static u32 park_at = 0xFFFFFFFFu;
+                      static unsigned long long park_since = 0, park_wait = ~0ull;
+                      if (park_wait == ~0ull) { const char* e = getenv("GCM_PARK_WAIT_MS");
+                          park_wait = e ? strtoull(e, NULL, 0) : 2000ull; }
+                      const unsigned long long now = ps3_ms_now();
+                      if (park_at != s_fifo_getoff) { park_at = s_fifo_getoff; park_since = now; }
+                      else if (now - park_since >= park_wait) {
+                          park_at = 0xFFFFFFFFu;
+                          gcm_fifo_dump_around(s_fifo_getoff);
+                          gcm_fifo_resync_why("jump-park", &s_fifo_getoff, put);
+                      }
+                  }
                   break;
               }
               s_fifo_getoff = tgt; }
diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index bf75dc8..f65df54 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -1567,7 +1567,7 @@ uint8_t  vm_read8 (uint64_t a) { if (vm_oob((uint32_t)a,1)) return 0; vm_hotmap(
     return vm_base[(uint32_t)a]; }
 uint16_t vm_read16(uint64_t a) { if (vm_oob((uint32_t)a,2)) return 0; ppu_rwatch_hit((uint32_t)a, 2, __builtin_return_address(0)); vm_hotmap((uint32_t)a,2); uint16_t v; memcpy(&v, vm_base + (uint32_t)a, 2);
     { static PPU_THREAD_LOCAL uint32_t last=0xFFFFFFFFu; static PPU_THREAD_LOCAL uint32_t n=0;
-      if ((uint32_t)a==last) { if (++n==200000) { fprintf(stderr, "[HOTREAD16] spinning on 0x%08X\n", (uint32_t)a); n=0; } } else { last=(uint32_t)a; n=0; } }
+      if ((uint32_t)a==last) { if (++n==200000) { fprintf(stderr, "[HOTREAD16] spinning on 0x%08X val=0x%04X tid=%lu guest-fn=0x%08X lr=0x%08X\n", (uint32_t)a, __builtin_bswap16(v), GetCurrentThreadId(), ppu_prof_resolve_host(__builtin_return_address(0)), g_active_ctx?(uint32_t)g_active_ctx->lr:0); n=0; } } else { last=(uint32_t)a; n=0; } }
     return __builtin_bswap16(v); }
 uint32_t vm_read32(uint64_t a) { if (vm_oob((uint32_t)a,4)) return 0; ppu_rwatch_hit((uint32_t)a, 4, __builtin_return_address(0));
     if ((uint32_t)a < 0x10000u) ppu_null_read_report((uint32_t)a, 4, __builtin_return_address(0));
-- 
